<?xml version="1.0" ?>
<robot name="procedural_waffleiron_1">
  <link name="root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_fixed" type="fixed">
    <parent link="root"/>
    <child link="bottom"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="bottom">
    <inertial>
      <origin xyz="0.0 0.0 0.007535594103255452" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="0.0 0.0 0.007535594103255452" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08045491317746427" length="0.015071188206510905"/></geometry>
    </visual>
    <collision>
