<?xml version="1.0" ?>
<robot name="procedural_waffleiron_4">
  <link name="root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_fixed" type="fixed">
    <parent link="yaw_link"/>
    <child link="bottom"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="bottom">
    <inertial>
      <origin xyz="0.0 0.0 0.005892718288354491" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="0.0 0.0 0.005892718288354491" rpy="0 0 0"/>
      <geometry><cylinder radius="0.09476879905104285" length="0.011785436576708982"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.005892718288354491" rpy="0 0 0"/>
      <geometry><cylinder radius="0.09476879905104285" length="0.011785436576708982"/></geometry>
    </collision>
  </link>

  <joint name="hinge_support_fixed" type="fixed">
    <parent link="bottom"/>
    <child link="hinge_support"/>
    <origin xyz="0.10587864596164606 0 0.011159227983072968" rpy="0 0 0"/>
  </joint>

  <link name="hinge_support">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.02777461727650804 0.058880672847908676 0.015176141314128321"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.02777461727650804 0.058880672847908676 0.015176141314128321"/></geometry>
    </collision>
  </link>

  <joint name="bottom_grip_fixed" type="fixed">
    <parent link="bottom"/>
    <child link="bottom_grip"/>
    <origin xyz="-0.10744125488689642 0 0.0074840098227644" rpy="0 -0.2591307915504447 0"/>
  </joint>

  <link name="bottom_grip">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.03329095179481087 0.04835407410349596 0.005383921498482472"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.03329095179481087 0.04835407410349596 0.005383921498482472"/></geometry>
    </collision>
  </link>

  <joint name="rotation" type="revolute">
    <parent link="bottom"/>
    <child link="top"/>
    <origin xyz="0.09476879905104285 0 0.011785436576708982" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
    <limit effort="50.0" velocity="50.0" lower="0.087" upper="2.4"/>
  </joint>

  <link name="top">
    <inertial>
      <origin xyz="-0.09628544858536735 0.0 0.004338704379878514" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="-0.09628544858536735 0.0 0.004338704379878514" rpy="0 0 0"/>
      <geometry><cylinder radius="0.09628544858536735" length="0.008677408759757027"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0.09628544858536735 0.0 0.004338704379878514" rpy="0 0 0"/>
      <geometry><cylinder radius="0.09628544858536735" length="0.008677408759757027"/></geometry>
    </collision>
  </link>

  <joint name="top_grip_fixed" type="fixed">
    <parent link="top"/>
    <child link="top_grip"/>
    <origin xyz="-0.20524335300658825 0 0.003936306400440103" rpy="0 0.22715515860484572 0"/>
  </joint>

  <link name="top_grip">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.03329095179481087 0.04835407410349596 0.005383921498482472"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.03329095179481087 0.04835407410349596 0.005383921498482472"/></geometry>
    </collision>
  </link>

  <link name="tx_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="tx_joint" type="prismatic">
    <parent link="root"/>
    <child link="tx_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-5.0" upper="5.0" effort="50" velocity="1"/>
  </joint>
  <link name="ty_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="ty_joint" type="prismatic">
    <parent link="tx_link"/>
    <child link="ty_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-5.0" upper="5.0" effort="50" velocity="1"/>
  </joint>
  <link name="tz_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="tz_joint" type="prismatic">
    <parent link="ty_link"/>
    <child link="tz_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-5.0" upper="5.0" effort="50" velocity="1"/>
  </joint>
  <link name="roll_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="roll_joint" type="revolute">
    <parent link="tz_link"/>
    <child link="roll_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-31.41592653589793" upper="31.41592653589793" effort="50" velocity="1"/>
  </joint>
  <link name="pitch_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="pitch_joint" type="revolute">
    <parent link="roll_link"/>
    <child link="pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-31.41592653589793" upper="31.41592653589793" effort="50" velocity="1"/>
  </joint>
  <link name="yaw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="yaw_joint" type="revolute">
    <parent link="pitch_link"/>
    <child link="yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-31.41592653589793" upper="31.41592653589793" effort="50" velocity="1"/>
  </joint>

</robot>
