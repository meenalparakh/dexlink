      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.13714168975236163 0.2610041289097494 0.0028248703202292374"/></geometry>
    </collision>
  </link>

  <joint name="rotation" type="revolute">
    <parent link="bottom"/>
    <child link="top"/>
    <origin xyz="0.06386865507333855 0 0.015244712376402694" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
    <limit effort="50.0" velocity="50.0" lower="0.087" upper="3.0"/>
  </joint>

  <link name="top">
    <inertial>
      <origin xyz="-0.0649216313608917 0.0 0.0065356413663719" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="-0.0649216313608917 0.0 0.0065356413663719" rpy="0 0 0"/>
      <geometry><box size="0.1298432627217834 0.2377995493077968 0.0130712827327438"/></geometry>
