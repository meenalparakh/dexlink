      <geometry><box size="0.19093336886723655 0.22617814862064545 0.002512857872607375"/></geometry>
    </collision>
  </link>

  <joint name="rotation" type="revolute">
    <parent link="bottom"/>
    <child link="top"/>
    <origin xyz="0.0931761865701198 0 0.018340482803729328" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
    <limit effort="50.0" velocity="50.0" lower="0.00135" upper="3.0"/>
  </joint>

  <link name="top">
    <inertial>
      <origin xyz="-0.0945951286818781 0.0 0.00538676072628381" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
