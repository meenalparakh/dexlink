<?xml version="1.0" ?>
<robot name="procedural_notebook_4">
  <link name="root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_fixed" type="fixed">
    <parent link="yaw_link"/>
    <child link="bottom"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="bottom">
    <inertial>
      <origin xyz="0.0 0.0 0.009170241401864664" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="0.0 0.0 0.009170241401864664" rpy="0 0 0"/>
      <geometry><box size="0.1863523731402396 0.21948158018913969 0.018340482803729328"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.009170241401864664" rpy="0 0 0"/>
      <geometry><box size="0.1863523731402396 0.21948158018913969 0.018340482803729328"/></geometry>
    </collision>
  </link>

  <joint name="bottom_cover_fixed" type="fixed">
    <parent link="bottom"/>
    <child link="bottom_cover"/>
    <origin xyz="-0.0022904978634984696 0 -0.0012564289363036875" rpy="0 0 0"/>
  </joint>

  <link name="bottom_cover">
