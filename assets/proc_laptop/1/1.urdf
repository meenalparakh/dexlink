<?xml version="1.0" ?>
<robot name="procedural_laptop_0">
  <link name="root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_fixed" type="fixed">
    <parent link="root"/>
    <child link="bottom"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="bottom">
    <inertial>
      <origin xyz="0.0 0.0 0.004962602614291918" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="0.0 0.0 0.004962602614291918" rpy="0 0 0"/>
      <geometry><box size="0.20557707193831534 0.20300129062672004 0.009925205228583835"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.004962602614291918" rpy="0 0 0"/>
      <geometry><box size="0.20557707193831534 0.20300129062672004 0.009925205228583835"/></geometry>
    </collision>
  </link>

  <joint name="rotation" type="revolute">
    <parent link="bottom"/>
    <child link="top"/>
    <origin xyz="0.10278853596915767 0 0.009925205228583835" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="2.0" friction="0.5"/>
    <limit effort="50.0" velocity="50.0" lower="0.087" upper="3.141592653589793"/>
  </joint>

  <link name="top">
    <inertial>
      <origin xyz="-0.10603182110188879 0.0 0.003227659059818525" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="-0.10603182110188879 0.0 0.003227659059818525" rpy="0 0 0"/>
      <geometry><box size="0.21206364220377757 0.20300129062672004 0.00645531811963705"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0.10603182110188879 0.0 0.003227659059818525" rpy="0 0 0"/>
      <geometry><box size="0.21206364220377757 0.20300129062672004 0.00645531811963705"/></geometry>
    </collision>
  </link>
</robot>
