<?xml version="1.0" ?>
<robot name="procedural_laptop_4">
  <link name="root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_fixed" type="fixed">
    <parent link="root"/>
    <child link="bottom"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="bottom">
    <inertial>
      <origin xyz="0.0 0.0 0.0051908768078129715" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="0.0 0.0 0.0051908768078129715" rpy="0 0 0"/>
      <geometry><box size="0.21223277007331232 0.2837767273985872 0.010381753615625943"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0051908768078129715" rpy="0 0 0"/>
      <geometry><box size="0.21223277007331232 0.2837767273985872 0.010381753615625943"/></geometry>
    </collision>
  </link>

  <joint name="rotation" type="revolute">
    <parent link="bottom"/>
    <child link="top"/>
    <origin xyz="0.10611638503665616 0 0.010381753615625943" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="2.0" friction="0.5"/>
    <limit effort="50.0" velocity="50.0" lower="0.087" upper="3.141592653589793"/>
  </joint>

  <link name="top">
    <inertial>
      <origin xyz="-0.11110437670119211 0.0 0.0028551372489647986" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>

    <visual>
      <origin xyz="-0.11110437670119211 0.0 0.0028551372489647986" rpy="0 0 0"/>
      <geometry><box size="0.22220875340238422 0.2837767273985872 0.005710274497929597"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0.11110437670119211 0.0 0.0028551372489647986" rpy="0 0 0"/>
      <geometry><box size="0.22220875340238422 0.2837767273985872 0.005710274497929597"/></geometry>
    </collision>
  </link>
</robot>
